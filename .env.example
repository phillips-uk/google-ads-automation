# Copy this to .env and fill in your values.
# See README.md for where to obtain each credential.

# Anthropic (Claude AI) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Shopify — Shopify Admin → Apps → Develop apps → Create private app
# Scopes required: read_products, write_products
SHOPIFY_ACCESS_TOKEN=shpat_...

# Monday.com — monday.com → Profile → Administration → API → Personal API Token
MONDAY_API_TOKEN=...

# Google Ads MCC customer ID (10 digits, no dashes)
MCC_ID=0000000000

# Absolute path to your Obsidian clients folder
# e.g. /Users/yourname/Documents/Obsidian/My Brain/Google Ads Clients
OBSIDIAN_BASE=/path/to/your/obsidian/vault/Google Ads Clients

# Optional overrides
# LOOKBACK_DAYS=30         # Default performance lookback window
# MIN_SPEND_TO_REVIEW=1    # Minimum spend (£) for search term review
# MIN_CLICKS_TO_REVIEW=3   # Minimum clicks for search term review
